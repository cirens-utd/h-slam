#!/usr/bin/env python3

import rospy
from std_msgs.msg import String
import time

def main():
    rospy.init_node("launch_pod_manager")

    open_commands = [
        "FR_OPEN",
        "BR_OPEN",
        "FL_OPEN",
        "BL_OPEN",
        "ALL_OPEN",
    ]    
    close_commands = [
        "FR_CLOSE",
        "BR_CLOSE",
        "FL_CLOSE",
        "BL_CLOSE",
        "ALL_CLOSE"
    ]
    topic = rospy.get_param("~topic", "esp32/tx")
    message = rospy.get_param("~message", "ALL_OPEN\n")

    # Use a latched publisher and publish several times to ensure delivery
    pub = rospy.Publisher(topic, String, queue_size=10, latch=True)
    # allow publisher to register with master
    rospy.sleep(0.8)

    rospy.loginfo("Publishing test string to %s: %s", topic, message)
    # for command in open_commands:
    #     pub.publish(command)
    #     rospy.loginfo("Publishing test string to %s: %s", topic, command)    
    # time.sleep(1)    
    # for command in close_commands:
    #     pub.publish(command)
    #     rospy.loginfo("Publishing test string to %s: %s", topic, command)
    pub.publish(message)
    rospy.sleep(0.1)

    rospy.loginfo("Publish complete.")


if __name__ == "__main__":
    main()